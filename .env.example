# Vercel serverless function env var (Settings → Environment Variables)
# URL from a Zapier "Webhooks by Zapier → Catch Hook" trigger. Point that
# Zap at whatever should happen next when someone completes the assessment
# (add to a sheet/CRM, notify Bill/Travis, add to an email list, etc.).
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/xxxxx/
